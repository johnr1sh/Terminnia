# Copy to the deployment host's project-root .env file.
# Use exact production frontend origins, comma-separated; no wildcard.
RUNNER_ALLOWED_ORIGINS=https://your-terminnia-domain.example
# Pin to a reviewed immutable MySQL 8.4 image digest before production.
MYSQL_IMAGE=mysql:8.4@sha256:REPLACE_WITH_REVIEWED_DIGEST
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
RUNNER_PORT=8787
